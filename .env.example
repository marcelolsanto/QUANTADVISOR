# ==============================================================================
# TEMPLATE DE CONFIGURAÇÃO DE AMBIENTE - QUANTADVISOR WEALTHTECH
# ==============================================================================
# Renomeie este arquivo para ".env" no seu ambiente de desenvolvimento ou
# configure estas variáveis nas configurações de App Service / Key Vault da Azure.

# --- Fuso Horário ---
TZ=America/Sao_Paulo

# --- Conexão Banco de Dados PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_NAME=devdb
DB_USER=devuser
DB_PASSWORD=sua_senha_segura_aqui
DATABASE_URL=postgresql://devuser:sua_senha_segura_aqui@db:5432/devdb

# --- Banco em Memória Redis ---
REDIS_HOST=quant_redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- URLs Internas dos Microsserviços ---
PYTHON_ENGINE_URL=http://motor_python:8000
GO_ENGINE_URL=http://coletor_go:8080

# --- Chave Secreta de Autenticação JWT ---
JWT_SECRET=sua_chave_jwt_secreta_aqui

# --- Provedores Financeiros & HuggingFace NLP ---
HF_TOKEN=seu_token_huggingface_aqui
APPID=seu_webull_appid_aqui
AppKey=seu_webull_appkey_aqui
AppSecret=seu_webull_appsecret_aqui

# --- Credenciais de Corretoras (Alpaca EUA & BTG Pactual B3) ---
ALPACA_API_KEY=PK_ALPACA_DEV_KEY
ALPACA_API_SECRET=ALPACA_DEV_SECRET_KEY
BTG_CLIENT_ID=btg_client_id_dev
BTG_CLIENT_SECRET=btg_client_secret_dev
